# Salin ke .env.local. (Variabel server Express — DATABASE_URL, JWT_SECRET, dst. —
# ada di DMS-BE/.env.example, bukan di sini.)

# URL Express backend (server-only). Diakses hanya dari Route Handlers / Server Components.
BACKEND_API_URL=http://localhost:5000

# "true"  = semua data dari mock (localStorage) — tidak butuh backend/PostgreSQL.
# "false" = pakai backend Express lewat /api/bff (butuh DMS-BE + PostgreSQL jalan).
NEXT_PUBLIC_USE_MOCKS=true
